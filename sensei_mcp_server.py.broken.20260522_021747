def _handle_tool(name: str, arguments: dict) -> dict:
    # Fast path: direct_answer bypasses the bridge entirely
    if name == "direct_answer":
        return {
            "content": [
                {
                    "type": "text",
                    "text": arguments.get("response", "How can I help?"),
                }
            ]
        }

    # If bridge is dead, fail fast for all other tools
    if not _bridge_alive():
        return {
            "content": [
                {
                    "type": "text",
                    "text": "Browser bridge is not responding. The Sensei side panel may be closed. Please open it in Chrome and try again.",
                }
            ],
            "isError": True,
        }

    if name == "sensei.chat":
        return _dispatch_with_session_fallback(
            {"type": "chat", **arguments},
            arguments.get("session_id", "mcp-default"),
            wait_seconds=arguments.get("wait_seconds", 5.0),
        )

    if name == "sensei.health":
        try:
            state = _get("/extension/queue_state", timeout=2.0)
            return {
                "content": [
                    {
                        "type": "text",
                        "text": f"Bridge OK: {state}",
                    }
                ]
            }
        except Exception as e:
            return {
                "content": [
                    {
                        "type": "text",
                        "text": f"Bridge error: {e}",
                    }
                ],
                "isError": True,
            }

    if name == "browser.navigate":
        return _dispatch_with_session_fallback(
            {"type": "navigate", **arguments},
            arguments.get("session_id", "mcp-default"),
            wait_seconds=arguments.get("wait_seconds", 5.0),
        )

    if name == "browser.click":
        return _dispatch_with_session_fallback(
            {"type": "click", **arguments},
            arguments.get("session_id", "mcp-default"),
            wait_seconds=arguments.get("wait_seconds", 5.0),
        )

    if name == "browser.fill":
        return _dispatch_with_session_fallback(
            {"type": "fill", **arguments},
            arguments.get("session_id", "mcp-default"),
            wait_seconds=arguments.get("wait_seconds", 5.0),
        )

    if name == "browser.read_local":
        return _dispatch_with_session_fallback(
            {"type": "read_local", **arguments},
            arguments.get("session_id", "mcp-default"),
            wait_seconds=arguments.get("wait_seconds", 5.0),
        )

    return {
        "content": [{"type": "text", "text": f"Unknown tool: {name}"}],
        "isError": True,
    }


def _send(msg: dict) -> None:
    raw = json.dumps(msg)
    sys.stdout.write(raw + "\n")
    sys.stdout.flush()


def main() -> None:
    while True:
        line = sys.stdin.readline()
        if not line:
            break
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            continue

        method = req.get("method")
        req_id = req.get("id")

        if method == "initialize":
            _send({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": PROTO_VERSION,
                    "capabilities": {},
                    "serverInfo": {
                        "name": SERVER_NAME,
                        "version": SERVER_VERSION,
                    },
                },
            })

        elif method == "tools/list":
            _send({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {"tools": TOOLS},
            })

        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            arguments = params.get("arguments", {})
            result = _handle_tool(name, arguments)
            _send({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": result,
            })

        elif method == "notifications/initialized":
            pass

        else:
            _send({
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {
                    "code": -32601,
                    "message": f"Method not found: {method}",
                },
            })


if __name__ == "__main__":
    main()
