"""sensei_mcp_server.py — MCP stdio server that fronts the Sensei bridge."""

from __future__ import annotations

import json
import sys
import time
import urllib.request
import urllib.error

BRIDGE = "http://127.0.0.1:8080"
PROTO_VERSION = "2024-11-05"
SERVER_NAME = "sensei-mcp"
SERVER_VERSION = "0.1.0"


def _post(path: str, body: dict, timeout: float = 10.0) -> dict:
    raw = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        BRIDGE + path,
        data=raw,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return json.loads(res.read().decode("utf-8"))


def _get(path: str, timeout: float = 5.0) -> dict:
    req = urllib.request.Request(BRIDGE + path, method="GET")
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return json.loads(res.read().decode("utf-8"))


def _bridge_alive(timeout: float = 1.0) -> bool:
    try:
        _get("/extension/queue_state", timeout=timeout)
        return True
    except Exception:
        return False


def _wait_for_result(action_id: str, wait_seconds: float = 5.0, poll_ms: int = 2000) -> dict:
    deadline = time.time() + wait_seconds
    while time.time() < deadline:
        try:
            res = _get(f"/extension/result?action_id={action_id}", timeout=3.0)
            if res.get("ok") and res.get("result"):
                return {
                    "ok": True,
                    "action_id": action_id,
                    "status": "completed",
                    **res,
                }
        except urllib.error.HTTPError as e:
            if e.code == 404:
                pass
            else:
                return {
                    "ok": False,
                    "action_id": action_id,
                    "status": "error",
                    "error": str(e),
                }
        except Exception as e:
            return {
                "ok": False,
                "action_id": action_id,
                "status": "error",
                "error": str(e),
            }
        time.sleep(poll_ms / 1000.0)
    return {
        "ok": False,
        "action_id": action_id,
        "status": "pending",
        "hint": "No result within wait window — is the Chrome extension side panel open and polling?",
    }


def _queue_depth(session_id: str) -> int | None:
    try:
        state = _get(f"/extension/queue_state?session_id={session_id}", timeout=3.0)
    except Exception:
        return None
    depth = state.get("queue_depth", {}).get(session_id)
    if depth is None:
        return None
    try:
        return int(depth)
    except Exception:
        return None


def _known_sessions(primary_session: str) -> list[str]:
    out: list[str] = []
    for sid in [primary_session, "mcp-default", "chat-default"]:
        if sid and sid not in out:
            out.append(sid)
    try:
        sess = _get("/extension/sessions", timeout=3.0)
        active = sess.get("active_side_panel_session", "").strip()
        if active and active not in out:
            out.append(active)
        for s in sess.get("known_sessions", []):
            s = str(s).strip()
            if s and s not in out:
                out.append(s)
    except Exception:
        pass
    return out


def _dispatch_with_session_fallback(action: dict, primary_session: str, wait_seconds: float = 5.0) -> dict:
    attempts: list[dict] = []
    for sid in _known_sessions(primary_session):
        push = _post("/extension/queue", {"session_id": sid, "action": action}, timeout=5.0)
        action_id = push.get("action_id") or [None]
        if isinstance(action_id, list):
            action_id = action_id[0] if action_id else None
        if not action_id:
            attempts.append({"session_id": sid, "status": "push_failed", "push": push})
            continue
        outcome = _wait_for_result(action_id, wait_seconds=wait_seconds)
        attempt = {
            "session_id": sid,
            "action_id": action_id,
            "status": outcome.get("status"),
        }
        depth = _queue_depth(sid)
        if depth is not None:
            attempt["queue_depth_after_wait"] = depth
        attempts.append(attempt)
        if outcome.get("status") == "completed":
            return {
                "ok": True,
                "session_used": sid,
                "action_id": action_id,
                "outcome": outcome,
                "attempts": attempts,
            }
    return {
        "ok": False,
        "status": "pending",
        "attempts": attempts,
    }


