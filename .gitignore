# Master AI — never commit runtime/secret files

# Logs
*.log
*.log.1.gz

# Runtime state + python bytecode
*.pyc
__pycache__/
sessions/
voices/
.cache
harvest.cache

# Package output
master-ai-v*.tar.gz
dist/
# 2026-09-29: `build/` was missing here. `pip wheel .` / `pip install -e .`
# leaves a full second copy of the source tree in build/lib/, and ruff's
# default excludes cover `_build` but NOT `build` -- so a stale
# build/lib/master_ai.py got linted (3,171 phantom F405 errors) and a
# plain `git add -A` would have committed a duplicate of the monolith.
build/
*.egg-info/

# Test artifacts
.coverage
.pytest_cache/
.ruff_cache/

# Image engine build/model/output churn
image_engine/models/
image_engine/stable-diffusion.cpp/
image_engine/out/

# Secrets (these actually live in $HOME, but defensive)
.master_ai_keys
*.key
*.pem
client_secret*.json
*token*.json
*.env
.env

# Personal state (lives in separate private repos)
memory/
.claude/

# Editor / backup churn
*.bak.*
*.swp
*~

*.egg-info/
